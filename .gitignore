/data/
/logs/
/exp*/logs/
!/exp1/logs/
/exp1/logs/*
!/exp1/logs/.gitkeep
/artifacts/

# Python build and environment outputs.
*.egg-info/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local IDE and OS files.
.idea/
.vscode/
.DS_Store

.opencode/server.lock.json
.opencode
/checkpoints/

# Experiment binary artifacts
/exp1/**/*.npz
/exp2/**/*.npz
/exp3/**/*.npz

# Exp4 generated results: keep CSV only
/exp4/results/**
!/exp4/results/**/
!/exp4/results/**/*.csv

# Generated experiment binaries
*.npz
*.pkl
*.pkl.lock
